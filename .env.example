# Copy sang .env rồi điền giá trị thật. .env đã được .gitignore.

# Flask session cookie secret — BẮT BUỘC đổi ở prod (random 32+ ký tự)
VNGG_LMS_SECRET_KEY=change-me-to-a-long-random-string

# Microsoft Entra SSO — để trống -> dropdown login (dev fallback) là cách duy nhất
SSO_TENANT_ID=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# Optional:
# SSO_REDIRECT_URI=https://lms.vng.com.vn/lms/sso/callback
# SSO_ALLOWED_DOMAIN=vng.com.vn
# SSO_ADMIN_EMAILS=admin1@vng.com.vn,admin2@vng.com.vn

# DB path — container mặc định /data/lms.db (Docker), local mặc định repo-root/lms.db
# LMS_DB_PATH=/data/lms.db
